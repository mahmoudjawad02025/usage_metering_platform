# ---------- PostgreSQL (used by docker compose) ----------
POSTGRES_USER=usage_metering
POSTGRES_PASSWORD=usage_metering_password
POSTGRES_DB=usage_metering_service
POSTGRES_PORT=5433



# ---------- Service ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DB_POOL_MAX=10
ADMIN_KEY=change_me_to_a_long_random_admin_key



# Local development (service runs on your machine, DB runs in Docker)
DATABASE_URL=postgres://usage_metering:usage_metering_password@localhost:5433/usage_metering_service
# Tests run against a separate database that is created automatically
TEST_DATABASE_URL=postgres://usage_metering:usage_metering_password@localhost:5433/usage_metering_service_test



# ---------- Example client (local development) ----------
SERVICE_URL=http://localhost:3000
CLIENT_PORT=8080
# Optional, only for Flutter hot reload during development (leave empty otherwise)
CORS_ORIGIN=