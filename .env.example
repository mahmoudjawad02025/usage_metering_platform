# ---------- PostgreSQL (used by docker compose) ----------
POSTGRES_USER=usage_metering
POSTGRES_PASSWORD=usage_metering_password
POSTGRES_DB=usage_metering_service
POSTGRES_PORT=5432

# ---------- Service ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DB_POOL_MAX=10
ADMIN_KEY=change_me_to_a_long_random_admin_key

# Local development (service runs on your machine, DB runs in Docker)
DATABASE_URL=postgres://usage_metering:usage_metering_password@localhost:5432/usage_metering_service